<div {{ attributes.defaults({
    class: class_names({
        'menu bg-gray-800 text-white': true,
        'open': open
    }),
}) }} data-controller="menu"
>
    <div class="flex flex-col h-full">
        {# Brand #}
        <div class="relative py-4 px-4 h-[80px]">
            <a class="flex items-center justify-center" href="{{ path('app_home') }}">
                <img src="{{ asset('build/images/logo-icon.svg') }}" alt="Logo" class="w-11">
            </a>
            <div
                    class="toggle flex items-center justify-center bg-gray-800 hover:bg-gray-700 w-[30px] h-[30px] absolute top-[55px] right-0 z-20"
                    data-action="click->menu#toggleMenu"
            >
                {{ ux_icon('uil:arrow', {class: 'w-5 h-5'}) }}
            </div>
        </div>

        {# Menu Links #}
        <div class="relative flex-1">
            <div class="nav-fade nav-fade-top"></div>
            <nav class="flex-1 px-2 py-4 space-y-2 overflow-x-hidden">
                {% for link in links %}
                    <a href="#" class="flex p-2 text-white rounded-lg hover:bg-gray-700 group">
                        <span class="link-icon flex items-center justify-center flex-shrink-0 w-[30px] h-6 text-gray-400 transition duration-75 group-hover:text-white">
                            {{ ux_icon(link.icon, {class: 'w-6 h-6'}) }}
                        </span>
                        {% if open %}
                            <span class="link-label ml-3 whitespace-nowrap">{{ link.label }}</span>
                        {% endif %}
                    </a>
                {% endfor %}
            </nav>
            <div class="nav-fade nav-fade-bottom"></div>
        </div>

        {# User Profile #}
        <div class="border-t border-gray-700 p-4 overflow-hidden">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                    <img class="h-8 w-8 rounded-full" src="https://picsum.photos/150/150" alt="Avatar">
                </div>
                {% if open %}
                    <div class="ml-3 user-info">
                        <p class="text-sm font-medium email-truncate">{{ app.user ? app.user.email : 'Utilisateur' }}</p>
                        <a href="{{ path('app_logout') }}" class="text-xs text-gray-400 hover:text-white">Déconnexion</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>